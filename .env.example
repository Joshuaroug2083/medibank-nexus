# ─── MediBank Nexus — Docker Compose Environment ─────────────────────────────
# Copy this to .env and fill in the required values before running docker compose.
#
#   cp .env.example .env

# ── Database ──────────────────────────────────────────────────────────────────
DB_NAME=medibank
DB_USER=postgres
DB_PASSWORD=CHANGE_ME_strong_db_password

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=CHANGE_ME_redis_password

# ── Auth (REQUIRED — generate with the commands below) ────────────────────────
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_ME_64_hex_chars
JWT_EXPIRES_IN=8h

# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_REFRESH_SECRET=CHANGE_ME_different_64_hex_chars
JWT_REFRESH_EXPIRES_IN=7d

# ── Encryption (REQUIRED — must be exactly 64 hex chars / 32 bytes) ───────────
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=CHANGE_ME_32_bytes_as_64_hex_chars

# ── CORS ──────────────────────────────────────────────────────────────────────
# The URL users will access the web app from
CLIENT_ORIGIN=http://localhost

# ── Ports (change if defaults clash) ─────────────────────────────────────────
WEB_PORT=80
API_PORT=3001

# ── AI Provider Keys (optional — users can supply their own via Settings) ─────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_AI_API_KEY=

# ── Google OAuth2 (optional — for calendar/drive integrations) ────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/api/v1/integrations/google/oauth-callback

# ── Rate Limiting ─────────────────────────────────────────────────────────────
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15
RATE_LIMIT_GENERAL=100
RATE_LIMIT_AUTH=10
